# Required by the web server at runtime; never build arguments or NEXT_PUBLIC_*.
# Use a dedicated database/user. Host must be reachable FROM the container;
# localhost inside Docker is the container itself, not the PostgreSQL server.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME
# Generate privately: openssl rand -hex 32 (no shared/default value).
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET

# Optional Compose settings. Pin an immutable image tag for production.
CJ_SPIDER_IMAGE=cj-spider:phase1
CJ_SPIDER_BIND_ADDRESS=127.0.0.1
CJ_SPIDER_PORT=3000

# One-time importer ONLY: put these in a separate protected file outside the repo.
# Do not pass them to the web container or Docker build.
# SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SOURCE_SERVICE_ROLE_KEY
